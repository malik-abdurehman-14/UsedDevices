# Public site URL (used for canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Inquiry emails via Resend (https://resend.com) — leave empty to fall back to mailto:
RESEND_API_KEY=
INQUIRY_TO_EMAIL=info@example.com
INQUIRY_FROM_EMAIL="Website <inquiry@example.com>"

# Google Analytics 4 measurement ID (loads only after visitor consent)
NEXT_PUBLIC_GA_ID=
# Search Console / Bing Webmaster verification codes (content="..." value only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
